#!/usr/bin/env bash
set -euo pipefail

source "${HOME}/.dotfiles/lib/config.sh"

if ! laravel_application_root; then
    abort "You are not in the root of a Laravel application."
fi

message="artisan"
if [[ "$#" -gt 0 ]]; then
    message+=" ${@}"
fi;

info "Executing 'php ${message}'"
php artisan "$@"
