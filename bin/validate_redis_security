#!/usr/bin/env bash
set -euo pipefail

source "${HOME}/.dotfiles/lib/config.sh"

ENV_FILE="${1:-}"

if [[ -z "${ENV_FILE}" ]]; then
  echo "Usage: validate_redis_security /path/to/app/.env" >&2
  exit 1
fi

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "Error: .env file not found at ${ENV_FILE}" >&2
  exit 1
fi

REDIS_CONF="/etc/redis/redis.conf"
PASSES=0
FAILS=0

get_redis_password() {
  local pass
  pass=$(sudo grep "^REDIS_PASSWORD=" "$1" | cut -d= -f2-)
  pass="${pass%\"}"
  pass="${pass#\"}"
  pass="${pass%\'}"
  pass="${pass#\'}"
  echo "${pass}"
}

check() {
  if [[ $1 -eq 0 ]]; then
    echo "  PASS: $2"
    ((PASSES++))
  else
    echo "  FAIL: $2"
    ((FAILS++))
  fi
}

REDIS_PASS=$(get_redis_password "${ENV_FILE}")

section "Redis Security Validation"

# Authentication
echo ""
echo "Authentication"
redis-cli ping 2>&1 | grep -q "NOAUTH"
check $? "Requires authentication"

redis-cli -a "${REDIS_PASS}" ping 2>/dev/null | grep -q "PONG"
check $? "Password from .env works"

if [[ ${#REDIS_PASS} -ge 20 ]]; then
  check 0 "Password strength (${#REDIS_PASS} chars)"
else
  check 1 "Password strength (only ${#REDIS_PASS} chars, want 20+)"
fi

# Network binding
echo ""
echo "Network binding"

if [[ -f "${REDIS_CONF}" ]]; then
  grep -qE "^bind\s+127\.0\.0\.1" "${REDIS_CONF}"
  check $? "Config binds to localhost"

  grep -qE "^protected-mode\s+yes" "${REDIS_CONF}"
  check $? "Protected mode enabled"
fi

if command -v ss >/dev/null 2>&1; then
  BIND_CHECK=$(sudo ss -tlnp | grep :6379 || true)
elif command -v netstat >/dev/null 2>&1; then
  BIND_CHECK=$(sudo netstat -tlnp | grep :6379 || true)
else
  BIND_CHECK=""
fi

if [[ -n "${BIND_CHECK}" ]]; then
  if echo "${BIND_CHECK}" | grep -qE "127\.0\.0\.1:6379|::1:6379"; then
    check 0 "Listening on localhost only"
  elif echo "${BIND_CHECK}" | grep -q "0.0.0.0:6379"; then
    check 1 "Listening on ALL interfaces"
  else
    check 0 "Binding appears secure"
  fi
else
  echo "  SKIP: Could not verify network binding (no ss/netstat)"
fi

# Dangerous commands
echo ""
echo "Dangerous commands"
for cmd in CONFIG FLUSHDB FLUSHALL SHUTDOWN; do
  OUTPUT=$(redis-cli -a "${REDIS_PASS}" "${cmd}" 2>&1 || true)
  if echo "${OUTPUT}" | grep -qi "unknown command\|renamed"; then
    check 0 "${cmd} is disabled"
  else
    check 1 "${cmd} is still enabled"
  fi
done

# Summary
echo ""
section "Results: ${PASSES} passed, ${FAILS} failed"

if [[ ${FAILS} -gt 0 ]]; then
  exit 1
fi
